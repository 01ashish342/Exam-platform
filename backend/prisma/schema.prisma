generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String
  role      Role      @default(STUDENT)
  createdAt DateTime  @default(now())
  attempts  Attempt[]
  exams     Exam[]    @relation("ExamCreatedBy")
}

model Exam {
  id              String     @id @default(uuid())
  title           String
  description     String?
  durationMinutes Int
  totalMarks      Float
  marksPerQ       Float      @default(1)
  negativeMarks   Float      @default(0)
  isPublished     Boolean    @default(false)
  createdBy       User       @relation("ExamCreatedBy", fields: [createdById], references: [id])
  createdById     String
  createdAt       DateTime   @default(now())
  questions       Question[]
  attempts        Attempt[]
}

model Question {
  id              String     @id @default(uuid())
  exam            Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  examId          String
  questionText    String
  options         Option[]
  correctOption   Option?    @relation("CorrectOption", fields: [correctOptionId], references: [id])
  correctOptionId String?    @unique
  order           Int        @default(0)
  section         String?
  responses       Response[]
}

model Option {
  id         String     @id @default(uuid())
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId String
  text       String
  correctFor Question?  @relation("CorrectOption")
  responses  Response[]
}

model Attempt {
  id           String        @id @default(uuid())
  user         User          @relation(fields: [userId], references: [id])
  userId       String
  exam         Exam          @relation(fields: [examId], references: [id])
  examId       String
  status       AttemptStatus @default(IN_PROGRESS)
  startedAt    DateTime      @default(now())
  submittedAt  DateTime?
  totalScore   Float?
  correctCount Int?
  wrongCount   Int?
  skippedCount Int?
  accuracy     Float?
  totalTimeSec Int?
  responses    Response[]

  @@index([userId, examId])
}

model Response {
  id                String    @id @default(uuid())
  attempt           Attempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  attemptId         String
  question          Question  @relation(fields: [questionId], references: [id])
  questionId        String
  selectedOption    Option?   @relation(fields: [selectedOptionId], references: [id])
  selectedOptionId  String?
  isCorrect         Boolean?
  timeTakenSec      Int       @default(0)
  answeredAt        DateTime?

  @@unique([attemptId, questionId])
}